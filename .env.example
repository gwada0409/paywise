# ==========================================
# PayWise Environment Configuration
# ==========================================

# Supabase Credentials (Required for auth & persistent storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Gemini AI Integration (@google/genai)
# Note: GEMINI_API_KEY is SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Server-side 32-byte encryption secret for secure in-database API key storage
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
